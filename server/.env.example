# Environment & Security Settings
APP_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Settings
SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key

# Candidate Access Tokens
CANDIDATE_ACCESS_TOKEN_TTL_HOURS=72

# ML Model Configuration
ML_MODEL_VERSION=resume_classifier_v1
ML_MODEL_PATH=ml/artifacts/resume_classifier_v1.joblib
ML_MODEL_METADATA_PATH=ml/artifacts/model_metadata_resume_classifier_v1.json

# SMTP Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@company.com
SMTP_FROM_NAME=HR Recruitment Department
SMTP_USE_TLS=true
